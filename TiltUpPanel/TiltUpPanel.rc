/////////////////////////////////////////////////////////////////////////////
//
// Dialog -- Phase 2: panel size + global groove + reveal list.
//
IDD_TILTUP_PANEL DIALOG DISCARDABLE 0, 0, 108, 262
STYLE WS_CHILD | WS_VISIBLE
FONT 8, "Microsoft Sans Serif"
BEGIN
LTEXT           "Width:", IDC_STATIC, 7, 8, 30, 8
CONTROL         "", IDC_WIDTH_EDIT, "CustEdit", WS_TABSTOP, 40, 7, 47, 10
CONTROL         "", IDC_WIDTH_SPIN, "SpinnerControl", 0x0, 87, 7, 8, 10

LTEXT           "Height:", IDC_STATIC, 7, 24, 30, 8
CONTROL         "", IDC_HEIGHT_EDIT, "CustEdit", WS_TABSTOP, 40, 23, 47, 10
CONTROL         "", IDC_HEIGHT_SPIN, "SpinnerControl", 0x0, 87, 23, 8, 10

LTEXT           "Depth:", IDC_STATIC, 7, 40, 30, 8
CONTROL         "", IDC_DEPTH_EDIT, "CustEdit", WS_TABSTOP, 40, 39, 47, 10
CONTROL         "", IDC_DEPTH_SPIN, "SpinnerControl", 0x0, 87, 39, 8, 10

LTEXT           "Groove W:", IDC_STATIC, 7, 56, 40, 8
CONTROL         "", IDC_GROOVE_W_EDIT, "CustEdit", WS_TABSTOP, 48, 55, 39, 10
CONTROL         "", IDC_GROOVE_W_SPIN, "SpinnerControl", 0x0, 87, 55, 8, 10

LTEXT           "Groove D:", IDC_STATIC, 7, 72, 40, 8
CONTROL         "", IDC_GROOVE_D_EDIT, "CustEdit", WS_TABSTOP, 48, 71, 39, 10
CONTROL         "", IDC_GROOVE_D_SPIN, "SpinnerControl", 0x0, 87, 71, 8, 10

CONTROL         "Inset L/R", IDC_EDGE_SIDES, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 7, 88, 94, 12
CONTROL         "Inset T/B", IDC_EDGE_TOPBOT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 7, 102, 94, 12

LTEXT           "Reveals:", IDC_STATIC, 7, 120, 40, 8
CONTROL         "", IDC_REVEAL_LIST, "LISTBOX", LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP | WS_BORDER, 7, 130, 94, 40

CONTROL         "Add Horiz", IDC_ADD_HORIZ, "Button", WS_TABSTOP, 7, 172, 46, 14
CONTROL         "Add Vert", IDC_ADD_VERT, "Button", WS_TABSTOP, 55, 172, 46, 14
CONTROL         "Remove", IDC_REMOVE_REVEAL, "Button", WS_TABSTOP, 7, 188, 94, 14

LTEXT           "Position:", IDC_STATIC, 7, 208, 40, 8
CONTROL         "", IDC_REVEAL_POS_EDIT, "CustEdit", WS_TABSTOP, 48, 207, 39, 10
CONTROL         "", IDC_REVEAL_POS_SPIN, "SpinnerControl", 0x0, 87, 207, 8, 10

CONTROL         "Edit Reveal Layout...", IDC_EDIT_LAYOUT, "Button", WS_TABSTOP, 7, 224, 94, 14
END
